    "deploy": {
      "type": "docker",
      "steps": [
        "git clone https://github.com/harry0703/MoneyPrinterTurbo.git",
        "cd MoneyPrinterTurbo",
        "cp config.example.toml config.toml",
        "docker compose -f docker-compose.release.yml up -d",
        "docker ps"
      ],
      "stepsPs": [
        "git clone https://github.com/harry0703/MoneyPrinterTurbo.git",
        "Set-Location MoneyPrinterTurbo",
        "Copy-Item config.example.toml config.toml",
        "docker compose -f docker-compose.release.yml up -d",
        "docker ps"
      ],
      "source": "https://github.com/harry0703/MoneyPrinterTurbo#docker-部署"
    },
    "pitfalls": [
      "容器起来就退出：确认已复制 `config.toml`",
      "页面打不开：确认 8501 端口未被占用",
      "生成失败：检查模型 Key 与素材 Key",
      "中文配音异常：换 TTS 供应商或检查语音参数",
      "字幕错位：切换字幕模式或调整时长",
      "磁盘爆满：定期清理 output 目录",
      "Windows 启动慢：确认 WSL2 与 Docker Desktop 正常"
    ]
  },
